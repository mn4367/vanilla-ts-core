{
  "name": "@vanilla-ts/core",
  "description": "TypeScript Web UI Library -- Core",
  "companyname": "mn4367",
  "copyright": "©2026 mn4367",
  "version": "0.3.0",
  "type": "module",
  "identifier": "mn4367.vanilla-ts.core",
  "keywords": [
    "typescript",
    "web",
    "ui",
    "library",
    "dom",
    "component"
  ],
  "homepage": "https://github.com/mn4367/vanilla-ts-core",
  "author": {
    "name": "mn4367",
    "email": "mn@mn4367.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mn4367/vanilla-ts-core.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/mn4367/vanilla-ts-core/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "types": "./types/index.d.ts"
    },
    "./build": {
      "import": "./lib/build/Build.js",
      "types": "./types/build/Build.d.ts"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@types/node": "22.14.1",
    "eslint-plugin-jsdoc": "63.2.0",
    "eslint": "10.7.0",
    "fast-glob": "3.3.3",
    "globals": "17.7.0",
    "npm-run-all2": "9.0.2",
    "rollup-plugin-css-only": "4.5.5",
    "rollup": "4.62.2",
    "shx": "0.4.0",
    "terser": "5.49.0",
    "tsc-watch": "7.2.1",
    "typescript-eslint": "8.65.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Watch": "npm-run-all -p watch:**",
    "Clean": "shx rm -rf ./types ./lib ./example/out ./example/index.js* ./playground/out ./playground/index.js*",
    "Build": "npm-run-all -p compile:src build:example build:playground",
    "Publish": "npm-run-all -s Clean compile:src && npm publish",
    "build:example": "npm-run-all -s compile:example pack:example",
    "build:playground": "npm-run-all -s compile:playground pack:playground",
    "watch:src": "tsc -w -p ./src/tsconfig.src.json",
    "watch:example": "tsc-watch -p ./example/src/tsconfig.example.json --onSuccess \"npm run pack:example\"",
    "watch:playground": "tsc-watch -p ./playground/src/tsconfig.playground.json --onSuccess \"npm run pack:playground\"",
    "compile:src": "tsc -p ./src/tsconfig.src.json",
    "compile:example": "tsc -p ./example/src/tsconfig.example.json",
    "compile:playground": "tsc -p ./playground/src/tsconfig.playground.json",
    "pack:example": "rollup --silent -c ./example/build/rollup.config.example.mjs",
    "pack:example:compress": "rollup --silent -c ./example/build/rollup.config.example.mjs --environment COMPRESS",
    "pack:playground": "rollup --silent -c ./playground/build/rollup.config.playground.mjs",
    "pack:playground:compress": "rollup --silent -c ./playground/build/rollup.config.playground.mjs --environment COMPRESS",
    "lint": "eslint -c ./eslint.config.mjs"
  },
  "files": [
    "lib",
    "src",
    "types"
  ]
}

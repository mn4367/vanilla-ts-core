{
  "name": "@vanilla-ts/core",
  "description": "TypeScript Web UI Library -- Core",
  "companyname": "mn4367",
  "version": "0.0.1",
  "copyright": "©2026 mn4367",
  "type": "module",
  "identifier": "mn4367.vanilla-ts.core",
  "keywords": [
    "typescript",
    "web",
    "ui",
    "library",
    "dom",
    "component"
  ],
  "homepage": "https://github.com/mn4367/vanilla-ts-core",
  "author": {
    "name": "mn4367",
    "email": "mn@mn4367.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mn4367/vanilla-ts-core.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/mn4367/vanilla-ts-core/issues"
  },
  "private": "false",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "types": "./types/index.d.ts"
    },
    "./build": {
      "import": "./lib/build/Build.js",
      "types": "./types/build/Build.d.ts"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@types/node": "22.14.1",
    "eslint-plugin-jsdoc": "62.7.1",
    "eslint": "10.0.2",
    "fast-glob": "3.3.3",
    "globals": "17.3.0",
    "npm-run-all2": "8.0.4",
    "rollup": "4.59.0",
    "shx": "0.4.0",
    "terser": "5.46.0",
    "tsc-watch": "7.2.0",
    "typescript-eslint": "8.56.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "Watch": "npm-run-all -p watch:*",
    "Clean": "shx rm -rf ./types ./lib ./example/out ./example/index.js*",
    "watch:src": "tsc -w -p ./src/tsconfig.src.json",
    "watch:example": "tsc-watch -p ./example/tsconfig.example.json --onSuccess \"npm run pack:example\"",
    "compile:src": "tsc -p ./src/tsconfig.src.json",
    "compile:example": "tsc -p ./example/tsconfig.example.json",
    "pack:example": "rollup --silent -c ./build/rollup.config.example.mjs",
    "pack:example:compress": "rollup --silent -c ./build/rollup.config.example.mjs --environment COMPRESS",
    "lint": "eslint -c ./eslintrc.json --parser-options=project:./tsconfig.json --ext .ts ."
  }
}
